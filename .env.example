DATABASE_URL=sqlite:///./blindmarket.db
# To use Supabase, replace DATABASE_URL with the URI from Dashboard > Connect.
# Session pooler (port 5432) works with local IPv4 connections.
# DATABASE_URL=postgresql+psycopg://postgres.PROJECT_REF:ENCODED_PASSWORD@YOUR_POOLER_HOST:5432/postgres?sslmode=require
# Transaction pooler (port 6543) is also supported; prepared statements are disabled automatically.
# Database credentials belong only in this backend environment, never NEXT_PUBLIC_*.
JWT_SECRET=replace-with-a-long-random-secret
NEXT_PUBLIC_API_URL=http://localhost:8000
